{
  "name": "agromont-corporate-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run generate:hero-assets && vinext dev --port 3005",
    "dev:vercel": "npm run generate:hero-assets && next dev -p 3005",
    "build": "npm run build:sites",
    "build:sites": "npm run generate:hero-assets && vinext build",
    "build:vercel": "npm run generate:hero-assets && next build",
    "start": "vinext start --port 3005",
    "start:vercel": "next start -p 3005",
    "test": "npm run build:sites && npm run build:vercel && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "generate:hero-assets": "node scripts/generate-hero-assets.mjs"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.2",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.3.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.2.1",
    "wrangler": "4.120.1"
  },
  "type": "module"
}
